---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { type Lang, site, tr, switchUrl } from '../i18n';
import '../styles/global.css';

interface Props {
	title: string;
	lang: Lang;
	description?: string;
}

const { title, lang, description = tr(site.description, lang) } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const other = switchUrl(lang, path);
const viPath = lang === 'vi' ? path : other;
const enPath = lang === 'en' ? path : other;
const abs = (p: string) => new URL(p === '/' ? '/' : `${p}/`, Astro.site).href;
const fullTitle = `${title} | ${site.name}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={abs(path)} />
		<link rel="alternate" hreflang="vi" href={abs(viPath)} />
		<link rel="alternate" hreflang="en" href={abs(enPath)} />
		<link rel="alternate" hreflang="x-default" href={abs(viPath)} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={abs(path)} />
		<meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
		<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#09090B" media="(prefers-color-scheme: dark)" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Be+Vietnam+Pro:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
		<script is:inline>
			// Light by default; a saved choice from the toggle wins. Runs before paint to avoid a flash.
			try {
				if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
			} catch {}
		</script>
	</head>
	<body class="min-h-screen flex flex-col">
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] btn btn-primary">{lang === 'vi' ? 'Chuyển đến nội dung' : 'Skip to content'}</a>
		<Navigation lang={lang} />
		<main id="main" class="flex-grow">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
