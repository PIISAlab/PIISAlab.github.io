---
import Layout from '../../layouts/Layout.astro';

const lang = 'vi'; // Default to Vietnamese for now
---

<Layout title="Home" lang={lang}>
	<!-- Hero Section -->
	<section class="relative py-20 overflow-hidden">
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-intellect/10 blur-[120px] rounded-full -z-10"></div>
		<div class="text-center">
			<h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
				Physics-Informed <br/>
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-intellect to-insight">Intelligent Systems</span>
			</h1>
			<p class="text-xl text-contrast/80 max-w-3xl mx-auto leading-relaxed">
				{lang === 'vi' 
					? 'Phòng Thí nghiệm Hệ thống Thông minh và Ứng dụng Dựa trên Vật lý (PIISA) Lab, Khoa Vật lý - Vật lý kỹ thuật, Trường Đại học Khoa học Tự nhiên, ĐHQG-HCM'
					: 'Physics-Informed Intelligent Systems and Applications (PIISA) Lab, Faculty of Physics and Engineering Physics, University of Science, VNUHCM'}
			</p>
		</div>
	</section>

	<div class="bento-grid mt-12">
		<!-- Welcome Card -->
		<div class="bento-card md:col-span-2">
			<h2 class="text-2xl mb-4 flex items-center">
				<span class="w-8 h-8 rounded-lg bg-insight/20 text-insight flex items-center justify-center mr-3 text-lg">✦</span>
				{lang === 'vi' ? 'Chào mừng bạn đến với PIISA Lab' : 'Welcome to PIISA Lab'}
			</h2>
			<div class="text-contrast/80 space-y-4">
				{lang === 'vi' ? (
					<>
						<p><strong>PIISA Lab</strong> là trung tâm nghiên cứu tiên phong trong việc kết hợp các quy luật vật lý cơ bản với các kỹ thuật trí tuệ nhân tạo hiện đại.</p>
						<p>Chúng tôi tận tâm giải quyết các thách thức kỹ thuật phức tạp trong mạng không dây thế hệ tiếp theo (6G), mô phỏng đa vật lý và thiết kế hệ thống thông minh.</p>
					</>
				) : (
					<>
						<p><strong>PIISA Lab</strong> is a leading research center focused on integrating fundamental physical laws with modern artificial intelligence techniques.</p>
						<p>We are dedicated to solving complex engineering challenges in next-generation wireless networks (6G), multiphysics simulation, and intelligent system design.</p>
					</>
				)}
			</div>
		</div>

		<!-- Latest News Card -->
		<div class="bento-card">
			<h2 class="text-2xl mb-4 flex items-center">
				<span class="w-8 h-8 rounded-lg bg-intellect/20 text-intellect flex items-center justify-center mr-3 text-lg">📢</span>
				{lang === 'vi' ? 'Tin tức mới nhất' : 'Latest News'}
			</h2>
			<div class="space-y-6">
				<div class="relative pl-6 border-l-2 border-intellect/30">
					<div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-intellect"></div>
					<span class="text-xs font-bold text-intellect uppercase tracking-wider">07 Tháng 4, 2026</span>
					<p class="text-sm mt-2 text-contrast/90 font-medium">
						{lang === 'vi' 
							? 'Bài báo "Electrohydrodynamics of a Liquid-Metal Monopole Antenna Channel" được chấp nhận đăng tại FEDSM2026.'
							: 'Paper "Electrohydrodynamics of a Liquid-Metal Monopole Antenna Channel" accepted at FEDSM2026.'}
					</p>
				</div>
			</div>
		</div>
	</div>
</Layout>
