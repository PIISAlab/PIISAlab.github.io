---
import Layout from '../layouts/Layout.astro';
import BentoCard from '../components/BentoCard.astro';
const lang = 'vi';
---
<Layout title="Cơ hội" lang={lang}>
	<section class="mb-16">
		<h1 class="text-5xl font-black mb-16 tracking-tighter">
			Cơ <span class="text-intellect font-montserrat italic">hội</span>
		</h1>

		<BentoCard class="max-w-4xl" showBorderBeam={true}>
			<h2 class="text-3xl mb-8 text-insight font-bold tracking-tight">Dành cho Sinh viên</h2>
			<div class="text-contrast/80 space-y-8">
				<p class="text-lg leading-relaxed">
					PIISA Lab luôn chào đón các sinh viên tài năng và nhiệt huyết tham gia nghiên cứu. Chúng tôi tìm kiếm các ứng viên có nền tảng tốt về vật lý, toán học và kỹ thuật.
				</p>
				
				<div class="grid md:grid-cols-3 gap-6">
					<div class="p-6 rounded-lg bg-intellect/5 border border-intellect/20 text-center group hover:bg-intellect/10 transition-colors">
						<span class="block text-4xl mb-3 group-hover:scale-110 transition-transform">🎓</span>
						<span class="font-black text-starlight tracking-widest text-sm uppercase">Nghiên cứu sinh</span>
					</div>
					<div class="p-6 rounded-lg bg-insight/5 border border-insight/20 text-center group hover:bg-insight/10 transition-colors">
						<span class="block text-4xl mb-3 group-hover:scale-110 transition-transform">📜</span>
						<span class="font-black text-starlight tracking-widest text-sm uppercase">Học viên cao học</span>
					</div>
					<div class="p-6 rounded-lg bg-innovation/5 border border-innovation/20 text-center group hover:bg-innovation/10 transition-colors">
						<span class="block text-4xl mb-3 group-hover:scale-110 transition-transform">🔬</span>
						<span class="font-black text-starlight tracking-widest text-sm uppercase">Sinh viên đại học</span>
					</div>
				</div>

				<div class="pt-10 border-t border-black/5 dark:border-white/5">
					<div class="flex items-center gap-4 text-intellect">
						<span class="w-10 h-10 rounded-full bg-intellect/10 flex items-center justify-center font-bold">!</span>
						<p class="text-lg font-medium italic leading-relaxed">
							Gửi CV và bảng điểm cho TS. Trương Trung Kiên qua email để ứng tuyển.
						</p>
					</div>
				</div>
			</div>
		</BentoCard>
	</section>
</Layout>
