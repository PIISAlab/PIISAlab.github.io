---
import Layout from '../../layouts/Layout.astro';
import BentoCard from '../../components/BentoCard.astro';
const lang = 'en';
---
<Layout title="Research" lang={lang}>
	<section class="mb-16">
		<h1 class="text-5xl font-black mb-16 tracking-tighter">
			Research & <span class="text-intellect font-montserrat italic">Engineering</span>
		</h1>

		<div class="bento-grid">
			<BentoCard class="col-span-full" showBorderBeam={true}>
				<h2 class="text-2xl font-bold tracking-tight text-starlight mb-8">Research Directions</h2>
				<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
					<div class="overflow-hidden rounded-lg bg-foundation border border-black/5 dark:border-white/5 hover:border-intellect/30 hover:shadow-sm transition-all duration-200">
						<img
							src="/images/research/ic-fpga.webp"
							alt="Isometric illustration of an FPGA chip mounted on a green printed circuit board, with glowing circuit traces running to two callout bubbles holding a signal-waveform icon and a video-playback icon."
							width="1200" height="900"
							loading="eager" fetchpriority="high" decoding="async"
							class="block w-full aspect-[4/3] object-cover object-center bg-[#12233F] dark:ring-1 dark:ring-inset dark:ring-white/10"
						/>
						<div class="p-6">
							<h3 class="text-lg font-semibold text-starlight tracking-tight mb-2">IC Design & FPGA/ASIC</h3>
							<p class="text-base text-contrast/70 leading-relaxed">Real-time hardware acceleration for image/video processing, AI, and DSP on FPGA/ASIC platforms.</p>
						</div>
					</div>
					<div class="overflow-hidden rounded-lg bg-foundation border border-black/5 dark:border-white/5 hover:border-intellect/30 hover:shadow-sm transition-all duration-200">
						<img
							src="/images/research/embedded-ai.webp"
							alt="Isometric illustration of a robotic arm on a four-wheeled chassis, linked by glowing traces to an &quot;AI&quot; neural-network node, an &quot;MCU&quot; chip icon, an STM32 microcontroller, and an Arduino UNO board."
							width="1200" height="900"
							loading="lazy" decoding="async"
							class="block w-full aspect-[4/3] object-cover object-center bg-[#12233F] dark:ring-1 dark:ring-inset dark:ring-white/10"
						/>
						<div class="p-6">
							<h3 class="text-lg font-semibold text-starlight tracking-tight mb-2">Embedded Systems & Edge AI</h3>
							<p class="text-base text-contrast/70 leading-relaxed">Robot control programming and edge AI applications on hybrid MPU/MCU architectures (STM32, Arduino UNO Q).</p>
						</div>
					</div>
					<div class="overflow-hidden rounded-lg bg-foundation border border-black/5 dark:border-white/5 hover:border-intellect/30 hover:shadow-sm transition-all duration-200">
						<img
							src="/images/research/wireless-6g.webp"
							alt="Isometric illustration of a &quot;6G&quot; antenna-array chip with a liquid-metal droplet on its surface, radio-wave arcs radiating to either side, alongside a padlock icon and a radar display."
							width="1200" height="900"
							loading="lazy" decoding="async"
							class="block w-full aspect-[4/3] object-cover object-center bg-[#12233F] dark:ring-1 dark:ring-inset dark:ring-white/10"
						/>
						<div class="p-6">
							<h3 class="text-lg font-semibold text-starlight tracking-tight mb-2">6G Wireless Communications</h3>
							<p class="text-base text-contrast/70 leading-relaxed">ISAC signal processing algorithms, physical layer security (PLS), and fluid antenna systems (FAS) for next-generation mobile networks.</p>
						</div>
					</div>
				</div>
			</BentoCard>

			<BentoCard class="col-span-full">
				<h2 class="text-2xl font-bold tracking-tight text-starlight mb-8">Education</h2>
				<div class="grid sm:grid-cols-2 gap-6 text-contrast/80">
					<div class="p-4 rounded-lg bg-foundation border border-black/5 dark:border-white/5">
						<strong class="text-starlight text-lg block mb-1">Design Thinking:</strong>
						<span class="text-base leading-relaxed italic">Human-centered approach in engineering solutions.</span>
					</div>
					<div class="p-4 rounded-lg bg-foundation border border-black/5 dark:border-white/5">
						<strong class="text-starlight text-lg block mb-1">Systems Thinking:</strong>
						<span class="text-base leading-relaxed italic">Developing a holistic view of complex intelligent systems.</span>
					</div>
				</div>
			</BentoCard>
		</div>
	</section>
</Layout>
