---
import Layout from '../../layouts/Layout.astro';
const lang = 'en';
---
<Layout title="Research" lang={lang}>
	<section class="mb-16">
		<h1 class="text-4xl font-bold mb-12 border-l-4 border-intellect pl-6">
			Research & Engineering
		</h1>

		<div class="bento-grid">
			<div class="bento-card md:col-span-2">
				<h2 class="text-2xl mb-6 text-insight">Research Pillars</h2>
				<ul class="space-y-4 text-contrast/80">
					<li class="flex items-start">
						<span class="text-intellect mr-3">→</span>
						<div>
							<strong class="text-starlight">6G Networks & Signal Processing:</strong>
							<p class="text-sm mt-1">Developing advanced algorithms for the next generation of wireless networks.</p>
						</div>
					</li>
					<li class="flex items-start">
						<span class="text-intellect mr-3">→</span>
						<div>
							<strong class="text-starlight">Multi-physics Simulation:</strong>
							<p class="text-sm mt-1">Simulating complex physical phenomena in antennas and wave propagation.</p>
						</div>
					</li>
				</ul>
			</div>
			
			<div class="bento-card">
				<h2 class="text-2xl mb-6 text-intellect">Education</h2>
				<ul class="space-y-4 text-contrast/80 text-sm">
					<li><strong>Design Thinking:</strong> Human-centered processes.</li>
					<li><strong>Systems Thinking:</strong> Holistic framework.</li>
				</ul>
			</div>
		</div>
	</section>
</Layout>
