---
import Layout from '../../layouts/Layout.astro';

const lang = 'en';
---

<Layout title="People" lang={lang}>
	<section class="mb-16">
		<h1 class="text-4xl font-bold mb-8 border-l-4 border-intellect pl-6">
			{lang === 'vi' ? 'Thành viên' : 'People'}
		</h1>

		<div class="bento-grid">
			<!-- PI Card -->
			<div class="bento-card md:col-span-3 flex flex-col md:flex-row gap-8 items-start">
				<div class="w-full md:w-64 h-64 bg-black/5 dark:bg-white/5 rounded-2xl overflow-hidden flex-shrink-0 border border-black/10 dark:border-white/10 flex items-center justify-center text-4xl text-contrast/20 font-bold">
					Photo
				</div>
				<div class="flex-grow">
					<h2 class="text-3xl font-bold mb-2">
						{lang === 'vi' ? 'TS. Trương Trung Kiên' : 'Dr. Kien Trung Truong'}
					</h2>
					<p class="text-intellect font-semibold mb-6">Principal Investigator</p>
					
					<div class="text-contrast/80 space-y-4 text-lg">
						{lang === 'vi' ? (
							<>
								<p><strong>TS. Trương Trung Kiên</strong> hiện là Giảng viên tại Khoa Vật lý - Vật lý kỹ thuật, Trường Đại học Khoa học Tự nhiên, ĐHQG-HCM. Ông là Senior Member của IEEE và là cựu sinh viên VEF.</p>
								<p>Ông nhận bằng Thạc sĩ và Tiến sĩ Kỹ thuật Điện tại Đại học Texas tại Austin (UT Austin) dưới sự hướng dẫn của Giáo sư Robert W. Heath, Jr. Các nghiên cứu của ông tập trung vào Massive MIMO, truyền tải năng lượng không dây và xử lý tín hiệu cho mạng 6G.</p>
							</>
						) : (
							<>
								<p><strong>Dr. Kien Trung Truong</strong> is a Lecturer in the Department of Physics and Engineering Physics at the University of Science, VNU-HCM. An IEEE Senior Member and VEF Alumnus.</p>
								<p>Dr. Truong earned his Ph.D. and M.S.E. in Electrical Engineering from the University of Texas at Austin under the supervision of Professor Robert W. Heath, Jr. His research interests include Massive MIMO, wireless power transfer, and signal processing for 6G networks.</p>
							</>
						)}
					</div>
				</div>
			</div>

			<!-- Current Members -->
			<div class="bento-card md:col-span-3">
				<h2 class="text-2xl font-bold mb-6">{lang === 'vi' ? 'Thành viên Hiện tại' : 'Current Members'}</h2>
				<p class="text-contrast/60 italic">
					{lang === 'vi' ? 'Thông tin đang được cập nhật...' : 'Information coming soon...'}
				</p>
			</div>
		</div>
	</section>
</Layout>
