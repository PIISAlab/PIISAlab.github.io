---
import Layout from '../../layouts/Layout.astro';
const lang = 'en';
---
<Layout title="Contact" lang={lang}>
	<section class="mb-16">
		<h1 class="text-4xl font-bold mb-12 border-l-4 border-intellect pl-6">
			Contact
		</h1>

		<div class="bento-grid">
			<div class="bento-card md:col-span-2">
				<h2 class="text-2xl mb-6 text-insight">Contact Information</h2>
				<div class="space-y-6 text-contrast/80">
					<div>
						<h3 class="text-starlight font-bold mb-2">Address:</h3>
						<p>PIISA Lab, Department of Physics and Engineering Physics, University of Science, VNU-HCM.</p>
						<p>227 Nguyen Van Cu Street, Ward 4, District 5, Ho Chi Minh City, Vietnam.</p>
					</div>
					<div>
						<h3 class="text-starlight font-bold mb-2">Email:</h3>
						<a href="mailto:truongkien@hcmus.edu.vn" class="text-intellect hover:text-insight underline">truongkien@hcmus.edu.vn</a>
					</div>
				</div>
			</div>
			
			<div class="bento-card flex items-center justify-center bg-intellect/5 border-intellect/20">
				<div class="text-center">
					<span class="block text-5xl mb-4">📍</span>
					<p class="text-sm font-bold text-intellect uppercase tracking-widest">HCMUS / VNU-HCM</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
