---
import Layout from '../../layouts/Layout.astro';

const lang = 'en';
---

<Layout title="Home" lang={lang}>
	<!-- Hero Section -->
	<section class="relative min-h-[70vh] flex flex-col items-center justify-center py-20 overflow-hidden">
		<!-- Dynamic Background Elements -->
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[800px] bg-intellect/20 blur-[160px] rounded-full -z-10 animate-pulse"></div>
		<div class="absolute bottom-0 right-1/4 w-[600px] h-[400px] bg-insight/10 blur-[120px] rounded-full -z-10"></div>

		<div class="text-center z-10 max-w-5xl px-4">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-intellect/10 border border-intellect/20 text-intellect text-xs font-bold uppercase tracking-wider mb-8 animate-fade-in">
				<span class="relative flex h-2 w-2">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-intellect opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-intellect"></span>
				</span>
				The Nexus of Physics & Intelligence
			</div>

			<h1 class="text-4xl md:text-8xl font-black tracking-tighter mb-8 leading-[1.1]">
				Physics-Informed <br/>
				<span class="text-gradient">Intelligent Systems</span>
			</h1>

			<p class="text-xl md:text-2xl text-contrast/80 max-w-3xl mx-auto leading-relaxed mb-12 font-medium">
				Physics-Informed Intelligent Systems and Applications (PIISA) Lab
				<span class="block text-sm mt-4 text-contrast/50 font-normal">Faculty of Physics and Engineering Physics, University of Science, VNU-HCM</span>
			</p>

			<div class="flex flex-wrap justify-center gap-4">
				<a href="/en/research.html" class="glass-button bg-intellect text-white border-transparent">
					Explore Research
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
				<a href="/en/publications.html" class="glass-button">
					View Publications
				</a>
			</div>
		</div>
	</section>

	<div class="bento-grid mt-24">
		<!-- Welcome Card -->
		<div class="bento-card md:col-span-2 group">
			<div class="flex flex-col h-full">
				<div class="mb-6">
					<span class="w-12 h-12 rounded-2xl bg-insight/10 text-insight flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
						✦
					</span>
				</div>
				<h2 class="text-3xl font-bold mb-4">Welcome to PIISA Lab</h2>
				<div class="text-lg text-contrast/80 space-y-4 flex-grow">
					<p>We are a pioneering research center dedicated to integrating <strong>fundamental physical laws</strong> with modern <strong>Artificial Intelligence</strong> techniques.</p>
					<p>Our mission is to solve complex engineering challenges in next-generation wireless networks (6G), multi-physics simulations, and intelligent system design.</p>
				</div>
				<div class="mt-8 flex gap-4">
					<div class="px-4 py-2 rounded-lg bg-foundation border border-black/5 dark:border-white/5 text-sm font-semibold">
						<span class="text-intellect">5+</span> Active Projects
					</div>
					<div class="px-4 py-2 rounded-lg bg-foundation border border-black/5 dark:border-white/5 text-sm font-semibold">
						<span class="text-insight">10+</span> Members
					</div>
				</div>
			</div>
		</div>

		<!-- Latest News Card -->
		<div class="bento-card bg-gradient-to-br from-intellect/10 to-transparent border-intellect/20">
			<h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
				<span class="p-2 rounded-lg bg-intellect/20 text-intellect">📢</span>
				News
			</h2>
			<div class="space-y-6">
				<div class="group/news cursor-default">
					<span class="text-xs font-bold text-intellect uppercase tracking-wider bg-intellect/10 px-2 py-1 rounded">April 07, 2026</span>
					<p class="text-base mt-3 text-starlight font-semibold leading-snug group-hover/news:text-intellect transition-colors">
						Paper "Electrohydrodynamics of a Liquid-Metal Monopole Antenna Channel" accepted at FEDSM2026.
					</p>
				</div>
			</div>
			<a href="/en/news.html" class="mt-12 inline-flex items-center gap-2 text-sm font-bold text-intellect hover:underline">
				All news
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
			</a>
		</div>

		<!-- Focus Area 1 -->
		<div class="bento-card group hover:border-innovation/30">
			<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
				<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/></svg>
			</div>
			<h3 class="text-xl font-bold mb-2 text-innovation">6G Communications</h3>
			<p class="text-contrast/70">Optimizing network resources and beamforming using AI-Physics integration.</p>
		</div>

		<!-- Focus Area 2 -->
		<div class="bento-card group hover:border-prestige/30">
			<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
				<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="7.5 4.21 12 6.81 16.5 4.21"/><polyline points="7.5 19.79 7.5 14.63 3 12"/><polyline points="21 12 16.5 14.63 16.5 19.79"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
			</div>
			<h3 class="text-xl font-bold mb-2 text-prestige">Multi-physics Simulation</h3>
			<p class="text-contrast/70">Simulating fluid dynamics and electromagnetic fields using neural networks.</p>
		</div>
	</div>
</Layout>

