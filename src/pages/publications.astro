---
import Layout from '../layouts/Layout.astro';
const lang = 'vi';
---
<Layout title="Publications" lang={lang}>
	<section class="mb-16">
		<h1 class="text-4xl font-bold mb-12 border-l-4 border-intellect pl-6">
			{lang === 'vi' ? 'Công bố & Dự án' : 'Publications & Projects'}
		</h1>

		<div class="space-y-8">
			<div class="bento-card">
				<h2 class="text-2xl mb-6 text-insight">{lang === 'vi' ? 'Bài báo tiêu biểu' : 'Selected Publications'}</h2>
				<div class="space-y-4">
					<div class="p-4 rounded-lg bg-white/5 border border-white/10">
						<span class="text-xs font-bold text-intellect px-2 py-1 bg-intellect/10 rounded mr-3">ASME 2026</span>
						<p class="mt-3 text-contrast/90">
							Nhật Minh Đoàn and Trung Kiên Trương, "Electrohydrodynamics of a Liquid-Metal Monopole Antenna Channel," accepted to <em>ASME 2026 Fluids Engineering Division Summer Meeting (FEDSM2026)</em>.
						</p>
					</div>
				</div>
			</div>

			<div class="bento-grid">
				<div class="bento-card">
					<h3 class="text-xl font-bold mb-4">{lang === 'vi' ? 'Dự án trọng điểm' : 'Key Projects'}</h3>
					<ul class="list-disc list-inside text-contrast/70 space-y-2 text-sm">
						<li>Liquid-metal antennas for 6G</li>
						<li>Multiphysics mobile simulation</li>
						<li>AI in radio signal processing</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
</Layout>
