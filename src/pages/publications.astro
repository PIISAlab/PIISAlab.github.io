---
import Layout from '../layouts/Layout.astro';
const lang = 'vi';

const publications = {
	journals: [
		{ id: '[J12]', title: 'Attacker Detection in Massive MIMO Systems over Spatially Uncorrelated Rician Fading Channels', authors: 'G. Q. L. Vu, H. Tran, C. V. Trinh, and K. T. Truong', venue: 'IEEE Access', year: '2022' },
		{ id: '[J11]', title: 'Phase Impairment Estimation for mmWave MIMO Systems with Low Resolutions ADC and Imperfect CSI', authors: 'N. D. Nguyen and K. T. Truong', venue: 'EAI Endorsed Transactions on Industrial Networks and Intelligent Systems', year: '2022' },
		{ id: '[J10]', title: 'Beam Division Multiple Access for Millimeter Wave Massive MIMO: Hybrid Zero-Forcing Beamforming with User Selection', authors: 'H. S. Vu, K. T. Truong, and M. T. Le', venue: 'International Journal of Electrical and Computer Engineering (IJECE)', year: '2022' },
		{ id: '[J09]', title: 'Resource Allocation in SWIPT Networks Under a Nonlinear Energy Harvesting Model: Power Efficiency, User Fairness, and Channel Nonreciprocity', authors: 'H.-V. Tran; G. Kaddoum and K. T. Truong', venue: 'IEEE Transactions on Vehicular Technology', year: '2018' },
		{ id: '[J08]', title: 'Effects of Channel Aging in Massive MIMO Systems', authors: 'K. T. Truong and R. W. Heath, Jr.', venue: 'IEEE/KICS Journal of Communications and Networks (JCN)', year: '2013' },
		{ id: '[J07]', title: 'Joint Transmit Precoding for the Relay Interference Broadcast Channel', authors: 'K. T. Truong and R. W. Heath, Jr.', venue: 'IEEE Transactions on Vehicular Technology', year: '2013' },
		{ id: '[J06]', title: 'A Distributed Algorithm using Interference Pricing for Relay Interference Channels', authors: 'K. T. Truong and R. W. Heath, Jr.', venue: 'EURASIP Journal on Advances in Signal Processing', year: '2013' },
		{ id: '[J05]', title: 'Cooperative Algorithms for MIMO Amplify-and-Forward Relay Networks', authors: 'K. T. Truong, P. Sartori and R. W. Heath, Jr.', venue: 'IEEE Transactions on Signal Processing', year: '2013' },
		{ id: '[J04]', title: 'Two-Way Transmission Capacity of Wireless ad-hoc Networks', authors: 'R. Vaze, K. T. Truong, S. Weber and R. W. Heath, Jr.', venue: 'IEEE Transactions on Wireless Communications', year: '2011' },
		{ id: '[J03]', title: 'Multimode Antenna Selection for MIMO Amplify-and-Forward Relay Systems', authors: 'K. T. Truong and R. W. Heath, Jr.', venue: 'IEEE Transactions on Signal Processing', year: '2010' },
		{ id: '[J02]', title: 'Interference Management Schemes for the Shared Relay Concept', authors: 'A. Y. Panah, K. T. Truong, S. W. Peters and R. W. Heath, Jr.', venue: 'EURASIP Journal on Advances in Signal Processing', year: '2011' },
		{ id: '[J01]', title: 'Relaying Architectures for 3GPP LTE-Advanced', authors: 'S. W. Peters, A. Y. Panah, K. T. Truong and R. W. Heath, Jr.', venue: 'EURASIP Journal on Wireless Communications and Networking (JWCN)', year: '2009' }
	],
	conferences: [
		{ id: '[C19]', title: 'Jammer Detection in Multicell Massive MIMO with Correlated Rician Channels', authors: 'G. Q. L. Vu, K. T. Truong, et al.', venue: 'IEEE ATC', year: '2025' },
		{ id: '[C18]', title: 'Using the STEAM-D Framework for Transdisciplinary Design Training...', authors: 'K. T. Truong, L. H. Phan, et al.', venue: 'E&PDE 2025', year: '2025' },
		{ id: '[C17]', title: 'Jammer Detection by Random Pilots in Massive MIMO...', authors: 'G. Q. L. Vu, H. Tran, and K. T. Truong', venue: 'NAFOSTED NICS', year: '2021' },
		{ id: '[C16]', title: 'Phase Impairment Estimation for mmWave MIMO Systems', authors: 'N. D. Nguyen and K. T. Truong', venue: 'NAFOSTED NICS', year: '2021' },
		{ id: '[C15]', title: 'Physical Layer Security of Massive MIMO...', authors: 'G. Q. L. Vu, T. N. Le and K. T. Truong', venue: 'IEEE ATC', year: '2021' },
		{ id: '[C14]', title: 'An Investigation of Adaptive Digital Beamforming Antenna for gNodeB 5G', authors: 'S. H. Vu, K. T. Truong, et al.', venue: 'IEEE ATC', year: '2019' },
		{ id: '[C13]', title: 'Internal Reciprocity Calibration for TDD Massive MIMO...', authors: 'Q. V. Dang, B. T. Le and K. T. Truong', venue: 'IEEE ATC', year: '2018' },
		{ id: '[C12]', title: 'Performance Analysis of Energy Harvesting Two-Way DF Relay Networks...', authors: 'T. A. Nguyen, B. Q. N. Vo and K. T. Truong', venue: 'IEEE ATC', year: '2018' },
		{ id: '[C11]', title: 'Compressive channel estimation in FDD multi-cell massive MIMO systems...', authors: 'N. González-Prelcic, K. T. Truong, et al.', venue: 'IEEE GLOBECOM', year: '2016' },
		{ id: '[C10]', title: 'FDD Massive MIMO with Analog CSI Feedback', authors: 'K. T. Truong, H. Nikopour and R. W. Heath Jr.', venue: 'IEEE Asilomar', year: '2015' },
		{ id: '[C09]', title: 'Optimal Training in Continuous Flat-Fading Massive MIMO Systems', authors: 'K. T. Truong, A. Lozano and R. W. Heath Jr.', venue: 'European Wireless Conference', year: '2014' },
		{ id: '[C08]', title: 'The Viability of Distributed Antennas for Massive MIMO Systems', authors: 'K. T. Truong and R. W. Heath Jr.', venue: 'IEEE Asilomar', year: '2013' },
		{ id: '[C07]', title: 'Relay Beamforming using Interference Pricing for the Two-hop Interference Channel', authors: 'K. T. Truong and R. W. Heath, Jr.', venue: 'IEEE GLOBECOM', year: '2011' },
		{ id: '[C06]', title: 'Interference Alignment for Multiple-Antenna AF Relay Interference Channels', authors: 'K. T. Truong and R. W. Heath, Jr.', venue: 'IEEE Asilomar', year: '2011' },
		{ id: '[C05]', title: 'Two-Way Transmission Capacity of Wireless Ad hoc Networks', authors: 'R. Vaze, K. T. Truong, et al.', venue: 'IEEE ISIT', year: '2010' },
		{ id: '[C04]', title: 'Adaptive Transmit Antenna Selection in MIMO AF Relay Channels', authors: 'K. T. Truong and R. W. Heath, Jr.', venue: 'IEEE ICASSP', year: '2010' },
		{ id: '[C03]', title: 'Transmission Capacity of Two-way Communication in Wireless Ad hoc Networks', authors: 'K. T. Truong, S. Weber and R. W. Heath, Jr.', venue: 'IEEE ICC', year: '2009' },
		{ id: '[C02]', title: 'An Experimetal Evaluation of Rate Adaptation for Multi-Antenna Systems', authors: 'W. Kim, M. O. Khan, K. T. Truong, et al.', venue: 'IEEE INFOCOM', year: '2009' },
		{ id: '[C01]', title: 'Throughput/Delay Measurements of Limited Feedback Beamforming...', authors: 'R. C. Daniels, K. Mandke, K. T. Truong, et al.', venue: 'IEEE GLOBECOM', year: '2008' }
	],
	patents: [
		{ id: '[P5]', title: 'Systems and Methods for Massive MIMO Adaptation', authors: 'K. T. Truong, R. W. Heath, Jr. and H. Nikopour', venue: 'US #10,686,498', year: '2020' },
		{ id: '[P4]', title: 'Method and apparatus for downlink channel estimation in massive MIMO', authors: 'K. T. Truong, R. W. Heath, Jr. and H. Nikopour', venue: 'US #10,374,836', year: '2019' },
		{ id: '[P3]', title: 'System and method for downlink channel estimation in massive MIMO', authors: 'K. T. Truong, P. Zhu, J. Ma and R. W. Heath, Jr.', venue: 'US #10,250,309', year: '2019' },
		{ id: '[P2]', title: 'System and Method for Distributed Power Control in a Communication System', authors: 'K. T. Truong, Y.-H. Kwon, P. Sartori and A.-S. Mazin', venue: 'US #8,706,026', year: '2014' },
		{ id: '[P1]', title: 'System and Method for Distributed Power Control in a Communication System', authors: 'K. T. Truong, Y.-H. Kwon and P. Sartori', venue: 'US #8,588,840', year: '2013' }
	],
	domestic: [
		{ id: '[DJ3]', title: 'The performance of a hybrid beamforming mmWave MIMO system...', authors: 'N. D. Nguyen, G. V. Nguyen and K. T. Truong', venue: 'Journal of Science and Technique', year: '2019' },
		{ id: '[DJ2]', title: 'Secret capacity of massive MIMO systems with a passive eavesdropper', authors: 'G. Q. L. Vu and K. T. Truong', venue: 'R&D on ICT', year: '2018' },
		{ id: '[DJ1]', title: 'Energy efficiency of FD-MIMO systems in 5G networks', authors: 'H. T. T. Nguyen and K. T. Truong', venue: 'Journal of S&T in IC', year: '2016' },
		{ id: '[DC2]', title: 'Performance analysis of mmWave systems with hardware impairments', authors: 'N. D. Nguyen and K. T. Truong', venue: 'REV-ECIT', year: '2018' },
		{ id: '[DC1]', title: 'Energy efficiency of downlink in massive MIMO systems', authors: 'B. D. Luong, H. T. T. Nguyen and K. T. Truong', venue: 'REV-ECIT', year: '2015' }
	]
};
---
<Layout title="Publications" lang={lang}>
	<section class="mb-16">
		<h1 class="text-4xl font-bold mb-12 border-l-4 border-intellect pl-6">
			{lang === 'vi' ? 'Toàn bộ Công bố' : 'Full Publication List'}
		</h1>

		<div class="space-y-16">
			<!-- International Journals -->
			<div>
				<h2 class="text-2xl mb-8 text-insight font-bold flex items-center">
					<span class="w-10 h-10 rounded-lg bg-insight/10 text-insight flex items-center justify-center mr-4 text-sm border border-insight/20">J</span>
					{lang === 'vi' ? 'Tạp chí Quốc tế' : 'International Journals'}
				</h2>
				<div class="grid gap-4">
					{publications.journals.map(pub => (
						<div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-intellect/50 hover:bg-white/[0.07] transition-all group">
							<div class="flex items-start gap-4">
								<span class="text-xs font-mono text-intellect bg-intellect/10 px-2 py-1 rounded shrink-0 mt-1">{pub.id}</span>
								<div>
									<h3 class="text-starlight font-bold leading-snug mb-2 group-hover:text-intellect transition-colors">{pub.title}</h3>
									<p class="text-sm text-contrast/60 mb-3">{pub.authors}</p>
									<div class="flex items-center text-xs text-intellect/80 font-medium">
										<span class="bg-intellect/5 px-2 py-0.5 rounded border border-intellect/10">{pub.venue}</span>
										<span class="mx-3 text-contrast/30">•</span>
										<span>{pub.year}</span>
									</div>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>

			<!-- International Conferences -->
			<div>
				<h2 class="text-2xl mb-8 text-intellect font-bold flex items-center">
					<span class="w-10 h-10 rounded-lg bg-intellect/10 text-intellect flex items-center justify-center mr-4 text-sm border border-intellect/20">C</span>
					{lang === 'vi' ? 'Hội nghị Quốc tế' : 'International Conferences'}
				</h2>
				<div class="grid gap-4">
					{publications.conferences.map(pub => (
						<div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-insight/50 hover:bg-white/[0.07] transition-all group">
							<div class="flex items-start gap-4">
								<span class="text-xs font-mono text-insight bg-insight/10 px-2 py-1 rounded shrink-0 mt-1">{pub.id}</span>
								<div>
									<h3 class="text-starlight font-bold leading-snug mb-2 group-hover:text-insight transition-colors">{pub.title}</h3>
									<p class="text-sm text-contrast/60 mb-3">{pub.authors}</p>
									<div class="flex items-center text-xs text-insight/80 font-medium">
										<span class="bg-insight/5 px-2 py-0.5 rounded border border-insight/10">{pub.venue}</span>
										<span class="mx-3 text-contrast/30">•</span>
										<span>{pub.year}</span>
									</div>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>

			<!-- Patents & Domestic -->
			<div class="grid md:grid-cols-2 gap-12">
				<div>
					<h2 class="text-2xl mb-8 text-starlight font-bold flex items-center">
						<span class="w-10 h-10 rounded-lg bg-white/10 text-starlight flex items-center justify-center mr-4 text-sm border border-white/20">P</span>
						{lang === 'vi' ? 'Bằng sáng chế US' : 'US Patents'}
					</h2>
					<div class="space-y-4">
						{publications.patents.map(pub => (
							<div class="p-5 rounded-xl bg-white/5 border border-white/10">
								<div class="flex justify-between items-start mb-2">
									<span class="text-xs font-mono text-intellect font-bold">{pub.id}</span>
									<span class="text-xs text-contrast/40">{pub.year}</span>
								</div>
								<h3 class="text-starlight font-bold mb-2 text-sm leading-tight">{pub.title}</h3>
								<p class="text-[10px] text-contrast/50 uppercase tracking-widest">{pub.venue}</p>
							</div>
						))}
					</div>
				</div>

				<div>
					<h2 class="text-2xl mb-8 text-contrast/80 font-bold flex items-center">
						<span class="w-10 h-10 rounded-lg bg-white/5 text-contrast/80 flex items-center justify-center mr-4 text-sm border border-white/10">D</span>
						{lang === 'vi' ? 'Trong nước' : 'Domestic'}
					</h2>
					<div class="space-y-4">
						{publications.domestic.map(pub => (
							<div class="p-5 rounded-xl bg-white/5 border border-white/10">
								<div class="flex justify-between items-start mb-2">
									<span class="text-xs font-mono text-insight font-bold">{pub.id}</span>
									<span class="text-xs text-contrast/40">{pub.year}</span>
								</div>
								<h3 class="text-starlight font-bold mb-2 text-sm leading-tight">{pub.title}</h3>
								<p class="text-[10px] text-contrast/50 italic">{pub.venue}</p>
							</div>
						))}
					</div>
				</div>
			</div>

			<!-- Theses -->
			<div class="bento-card bg-intellect/5 border-intellect/20">
				<h2 class="text-xl font-bold mb-6 flex items-center">
					<span class="mr-3">🎓</span>
					Theses
				</h2>
				<div class="grid md:grid-cols-2 gap-8">
					<div class="border-l-2 border-intellect/30 pl-6">
						<span class="text-[10px] text-intellect font-bold uppercase tracking-tighter">Ph.D. Dissertation (2012)</span>
						<p class="text-starlight font-bold mt-1">Transmission Strategies for Wireless Multiple-Antenna Relay-Assisted Networks</p>
						<p class="text-xs text-contrast/60 mt-2">The University of Texas at Austin</p>
					</div>
					<div class="border-l-2 border-insight/30 pl-6">
						<span class="text-[10px] text-insight font-bold uppercase tracking-tighter">Master's Report (2008)</span>
						<p class="text-starlight font-bold mt-1">The Transmission Capacity of Two-way Communication in Wireless Ad-hoc Networks</p>
						<p class="text-xs text-contrast/60 mt-2">The University of Texas at Austin</p>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
