---
import Layout from "../../layouts/Layout.astro";
import BentoCard from "../../components/BentoCard.astro";
import { type Lang, langPaths } from "../../i18n";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };

const t = {
	"vi": {
		"s0": "Cơ hội",
		"s1": ["Cơ", "hội"],
		"s2": "Dành cho Sinh viên",
		"s3": "luôn chào đón các sinh viên tài năng và nhiệt huyết tham gia nghiên cứu. Chúng tôi tìm kiếm các ứng viên có nền tảng tốt về vật lý, toán học và kỹ thuật.",
		"s4": "Nghiên cứu sinh",
		"s5": "Học viên cao học",
		"s6": "Sinh viên đại học",
		"s7": "Gửi CV và bảng điểm cho TS. Trương Trung Kiên qua email để ứng tuyển."
	},
	"en": {
		"s0": "Opportunities",
		"s1": ["Join the", "Lab"],
		"s2": "For Prospective Students",
		"s3": "is always looking for talented and motivated students to join our research efforts. We seek candidates with a strong foundation in physics, mathematics, and engineering.",
		"s4": "Ph.D. Candidates",
		"s5": "Master Students",
		"s6": "Undergraduates",
		"s7": "Send your CV and academic transcripts to Dr. Kien Truong via email to apply."
	}
}[lang];
---
<Layout title={t.s0} lang={lang}>
	<section class="mb-16">
		<h1 class="text-5xl font-black mb-16 tracking-tighter">
			{t.s1[0]} <span class="text-intellect font-montserrat italic">{t.s1[1]}</span>
		</h1>

		<BentoCard class="max-w-4xl" showBorderBeam={true}>
			<h2 class="text-3xl mb-8 text-insight font-bold tracking-tight">{t.s2}</h2>
			<div class="text-contrast/80 space-y-8">
				<p class="text-lg leading-relaxed">
					PIISA Lab {t.s3}
				</p>
				
				<div class="grid md:grid-cols-3 gap-6">
					<div class="p-6 rounded-lg bg-intellect/5 border border-intellect/20 text-center group hover:bg-intellect/10 transition-colors">
						<span class="block text-4xl mb-3 group-hover:scale-110 transition-transform">🎓</span>
						<span class="font-black text-starlight tracking-widest text-sm uppercase">{t.s4}</span>
					</div>
					<div class="p-6 rounded-lg bg-insight/5 border border-insight/20 text-center group hover:bg-insight/10 transition-colors">
						<span class="block text-4xl mb-3 group-hover:scale-110 transition-transform">📜</span>
						<span class="font-black text-starlight tracking-widest text-sm uppercase">{t.s5}</span>
					</div>
					<div class="p-6 rounded-lg bg-innovation/5 border border-innovation/20 text-center group hover:bg-innovation/10 transition-colors">
						<span class="block text-4xl mb-3 group-hover:scale-110 transition-transform">🔬</span>
						<span class="font-black text-starlight tracking-widest text-sm uppercase">{t.s6}</span>
					</div>
				</div>

				<div class="pt-10 border-t border-black/5 dark:border-white/5">
					<div class="flex items-center gap-4 text-intellect">
						<span class="w-10 h-10 rounded-full bg-intellect/10 flex items-center justify-center font-bold">!</span>
						<p class="text-lg font-medium italic leading-relaxed">
							{t.s7}
						</p>
					</div>
				</div>
			</div>
		</BentoCard>
	</section>
</Layout>
