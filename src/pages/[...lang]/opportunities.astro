---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Arrow from '../../components/Arrow.astro';
import { type Lang, langPaths, site, url } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };

const t = {
	vi: {
		title: 'Cơ hội', eyebrow: 'Cơ hội', h1: 'Tham gia PIISA',
		lead: 'PIISA Lab luôn chào đón các sinh viên tài năng và nhiệt huyết tham gia nghiên cứu. Chúng tôi tìm kiếm các ứng viên có nền tảng tốt về vật lý, toán học và kỹ thuật.',
		tracks: 'Dành cho sinh viên',
		levels: ['Nghiên cứu sinh', 'Học viên cao học', 'Sinh viên đại học'],
		apply: 'Cách ứng tuyển', applyText: 'Gửi CV và bảng điểm cho TS. Trương Trung Kiên qua email để ứng tuyển.',
		email: 'Gửi email ứng tuyển', research: 'Xem các hướng nghiên cứu',
	},
	en: {
		title: 'Opportunities', eyebrow: 'Opportunities', h1: 'Join the lab',
		lead: 'PIISA Lab is always looking for talented and motivated students to join our research efforts. We seek candidates with a strong foundation in physics, mathematics, and engineering.',
		tracks: 'For prospective students',
		levels: ['Ph.D. Candidates', 'Master Students', 'Undergraduates'],
		apply: 'How to apply', applyText: 'Send your CV and academic transcripts to Dr. Kien Truong via email to apply.',
		email: 'Email your application', research: 'Explore research directions',
	},
}[lang];
---
<Layout title={t.title} lang={lang}>
	<PageHeader eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

	<div class="page py-12">
		<h2 class="section-title">{t.tracks}</h2>
		<ul class="mt-6 grid gap-4 sm:grid-cols-3">
			{t.levels.map((level) => (
				<li class="card p-6">
					<h3 class="text-lg">{level}</h3>
				</li>
			))}
		</ul>

		<section class="card mt-10 flex flex-col gap-6 border-transparent bg-brand-surface p-8 md:flex-row md:items-center md:justify-between">
			<div>
				<h2 class="section-title">{t.apply}</h2>
				<p class="mt-2 text-fg-muted">{t.applyText}</p>
			</div>
			<div class="flex flex-wrap gap-3 shrink-0">
				<a href={`mailto:${site.email}`} class="btn btn-primary">{t.email} <Arrow /></a>
				<a href={url(lang, '/research')} class="btn btn-outline bg-card">{t.research}</a>
			</div>
		</section>
	</div>
</Layout>
