---
import { list } from '../../content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PubItem from '../../components/PubItem.astro';
import { type Lang, langPaths } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };

const all = await list('publications');
const years = [...new Set(all.map((p) => p.year))].sort((a, b) => b - a);

const t = {
	vi: {
		title: 'Công bố', eyebrow: 'Công bố', h1: 'Công bố khoa học',
		lead: 'Bài báo tạp chí, hội nghị, bằng sáng chế và luận án của nhóm. Nhấn vào tiêu đề để mở bài báo qua DOI.',
		all: 'Tất cả', allYears: 'Mọi năm', search: 'Tìm theo tiêu đề, tác giả, nơi công bố…', none: 'Không có công bố phù hợp.', shown: 'công bố',
		groups: { journal: 'Tạp chí Quốc tế', conference: 'Hội nghị Quốc tế', patent: 'Bằng sáng chế US', domestic: 'Công bố Trong nước', thesis: 'Luận án & Luận văn' },
	},
	en: {
		title: 'Publications', eyebrow: 'Publications', h1: 'Publications',
		lead: 'Journal and conference papers, patents, and theses from the lab. Click a title to open the paper via its DOI.',
		all: 'All', allYears: 'All years', search: 'Search title, author, venue…', none: 'No matching publications.', shown: 'shown',
		groups: { journal: 'International Journals', conference: 'International Conferences', patent: 'US Patents', domestic: 'Domestic Publications', thesis: 'Theses' },
	},
}[lang];

const groups = [
	{ key: 'journal', items: all.filter((p) => p.type === 'journal') },
	{ key: 'conference', items: all.filter((p) => p.type === 'conference') },
	{ key: 'patent', items: all.filter((p) => p.type === 'patent') },
	{ key: 'domestic', items: all.filter((p) => p.type.startsWith('domestic')) },
	{ key: 'thesis', items: all.filter((p) => p.type === 'thesis') },
] as const;
---
<Layout title={t.title} lang={lang}>
	<PageHeader eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

	<div class="page py-10">
		<form data-pub-filter class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between" role="search" onsubmit="return false">
			<div class="flex flex-wrap gap-2" role="group" aria-label={t.eyebrow}>
				<button type="button" data-group="all" aria-pressed="true" class="filter-chip">{t.all} <span class="tabular-nums">{all.length}</span></button>
				{groups.map((g) => <button type="button" data-group={g.key} aria-pressed="false" class="filter-chip">{t.groups[g.key]} <span class="tabular-nums">{g.items.length}</span></button>)}
			</div>
			<div class="flex gap-2">
				<select name="year" aria-label={t.allYears} class="h-10 rounded-md border border-line-strong bg-card px-3 font-ui text-sm text-fg">
					<option value="">{t.allYears}</option>
					{years.map((y) => <option value={y}>{y}</option>)}
				</select>
				<input type="search" name="q" placeholder={t.search} aria-label={t.search} class="h-10 w-full md:w-72 rounded-md border border-line-strong bg-card px-3 font-ui text-sm text-fg placeholder:text-fg-subtle" />
			</div>
		</form>
		<p data-pub-count class="mt-4 font-ui text-sm text-fg-subtle" aria-live="polite"></p>

		{groups.map((g) => (
			<section data-section={g.key} class="mt-10" aria-labelledby={`pub-${g.key}`}>
				<h2 id={`pub-${g.key}`} class="section-title">{t.groups[g.key]}</h2>
				<ul class="card mt-4 px-5">
					{g.items.map((p) => <PubItem pub={p} lang={lang} />)}
				</ul>
			</section>
		))}
		<p data-pub-empty hidden class="mt-10 text-fg-muted">{t.none}</p>
	</div>
</Layout>

<style is:global>
	.filter-chip {
		display: inline-flex; align-items: center; gap: 0.375rem; height: 2rem; padding-inline: 0.75rem;
		border-radius: var(--radius-md); border: 1px solid var(--border-default); background: var(--surface-card);
		font-family: var(--font-ui); font-size: 0.8125rem; font-weight: 500; color: var(--text-secondary);
		transition: background-color 150ms ease-out, color 150ms ease-out, border-color 150ms ease-out;
	}
	.filter-chip span { color: var(--text-tertiary); }
	.filter-chip:hover { border-color: var(--border-strong); color: var(--text-primary); }
	.filter-chip[aria-pressed='true'] { background: var(--surface-brand); border-color: transparent; color: var(--text-brand); }
	.filter-chip[aria-pressed='true'] span { color: inherit; }
</style>

<script define:vars={{ shownLabel: t.shown }}>
	const form = document.querySelector('[data-pub-filter]');
	const chips = [...form.querySelectorAll('[data-group]')];
	const sections = [...document.querySelectorAll('[data-section]')];
	const count = document.querySelector('[data-pub-count]');
	const empty = document.querySelector('[data-pub-empty]');
	let group = 'all';
	const norm = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

	function apply() {
		const year = form.year.value;
		const q = norm(form.q.value.trim());
		let shown = 0;
		for (const sec of sections) {
			let inSec = 0;
			for (const li of sec.querySelectorAll('li')) {
				const ok = (!year || li.dataset.year === year) && (!q || norm(li.textContent).includes(q));
				li.hidden = !ok;
				if (ok) inSec++;
			}
			sec.hidden = (group !== 'all' && sec.dataset.section !== group) || inSec === 0;
			if (!sec.hidden) shown += inSec;
		}
		count.textContent = `${shown} ${shownLabel}`;
		empty.hidden = shown > 0;
	}
	chips.forEach((c) => c.addEventListener('click', () => {
		group = c.dataset.group;
		chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
		apply();
	}));
	form.addEventListener('input', apply);
	apply();
</script>
