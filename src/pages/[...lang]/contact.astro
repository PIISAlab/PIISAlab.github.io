---
import Layout from "../../layouts/Layout.astro";
import BentoCard from "../../components/BentoCard.astro";
import { type Lang, langPaths } from "../../i18n";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };

const t = {
	"vi": {
		"s0": "Liên hệ",
		"s1": ["Kết", "nối"],
		"s2": "Thông tin Liên hệ",
		"s3": "Địa chỉ:",
		"s4": "Bộ môn Vật lý tin học, Khoa Vật lý - Vật lý kỹ thuật",
		"s5": "Trường Đại học Khoa học Tự nhiên, ĐHQG-HCM.",
		"s6": "Nguyễn Văn Cừ, Phường 4, Quận 5, TP. Hồ Chí Minh, Việt Nam."
	},
	"en": {
		"s0": "Contact",
		"s1": ["Get in", "Touch"],
		"s2": "Contact Information",
		"s3": "Address:",
		"s4": "Faculty of Physics - Engineering Physics",
		"s5": "University of Science, VNU-HCM.",
		"s6": "Nguyen Van Cu Street, Ward 4, District 5, Ho Chi Minh City, Vietnam."
	}
}[lang];
---
<Layout title={t.s0} lang={lang}>
	<section class="mb-16">
		<h1 class="text-5xl font-black mb-16 tracking-tighter">
			{t.s1[0]} <span class="text-intellect font-montserrat italic">{t.s1[1]}</span>
		</h1>

		<div class="bento-grid mb-8">
			<BentoCard class="md:col-span-2" showBorderBeam={true}>
				<h2 class="text-3xl mb-10 text-insight font-bold tracking-tight">{t.s2}</h2>
				<div class="space-y-10 text-contrast/80">
					<div class="p-6 rounded-lg bg-foundation border border-black/5 dark:border-white/5">
						<h3 class="text-xl text-starlight font-bold mb-4 flex items-center gap-3">
							<span class="p-2 rounded-lg bg-intellect/10 text-intellect">📍</span>
							{t.s3}
						</h3>
						<div class="text-lg leading-relaxed pl-12">
							<p class="font-bold text-starlight">PIISA Lab, {t.s4}</p>
							<p>{t.s5}</p>
							<p>227 {t.s6}</p>
						</div>
					</div>
					<div class="p-6 rounded-lg bg-foundation border border-black/5 dark:border-white/5">
						<h3 class="text-xl text-starlight font-bold mb-4 flex items-center gap-3">
							<span class="p-2 rounded-lg bg-intellect/10 text-intellect">✉️</span>
							Email:
						</h3>
						<div class="pl-12">
							<a href="mailto:truongkien@hcmus.edu.vn" class="text-2xl font-montserrat italic text-intellect hover:text-insight transition-colors underline decoration-intellect/30 underline-offset-8">truongkien@hcmus.edu.vn</a>
						</div>
					</div>
				</div>
			</BentoCard>
		</div>

		<!-- Map: full-width, explicit height, no broken h-full chain -->
		<div class="rounded-lg overflow-hidden border border-neutral-200 dark:border-neutral-800 h-[420px]">
			<iframe
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.630773293551!2d106.6799830758414!3d10.762912959444738!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f1c06f4e593%3A0xd6e07adca6940a45!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBLaG9hIGjhu41jIFThu7EgbmnDqm4gLSDEkEhRRyBUUEhDTQ!5e0!3m2!1svi!2s!4v1714316143415!5m2!1svi!2s"
				width="100%"
				height="100%"
				style="border:0; display:block;"
				allowfullscreen=""
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
			></iframe>
		</div>
	</section>
</Layout>
