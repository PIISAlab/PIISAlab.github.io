---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { type Lang, langPaths, site } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };

const t = {
	vi: {
		title: 'Liên hệ', eyebrow: 'Liên hệ', h1: 'Liên hệ với PIISA',
		lead: 'Liên hệ về hợp tác nghiên cứu, cơ hội cho sinh viên hoặc các câu hỏi khác qua email.',
		address: 'Địa chỉ', email: 'Email', map: 'Bản đồ Trường Đại học Khoa học Tự nhiên, ĐHQG-HCM', directions: 'Mở trong Google Maps',
		lines: ['PIISA Lab, Bộ môn Vật lý tin học, Khoa Vật lý - Vật lý kỹ thuật', 'Trường Đại học Khoa học Tự nhiên, ĐHQG-HCM', '227 Nguyễn Văn Cừ, Phường 4, Quận 5, TP. Hồ Chí Minh, Việt Nam'],
	},
	en: {
		title: 'Contact', eyebrow: 'Contact', h1: 'Get in touch',
		lead: 'Reach us by email about research collaboration, student opportunities, or any other questions.',
		address: 'Address', email: 'Email', map: 'Map of the University of Science, VNU-HCM', directions: 'Open in Google Maps',
		lines: ['PIISA Lab, Faculty of Physics - Engineering Physics', 'University of Science, VNU-HCM', '227 Nguyen Van Cu Street, Ward 4, District 5, Ho Chi Minh City, Vietnam'],
	},
}[lang];
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.630773293551!2d106.6799830758414!3d10.762912959444738!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f1c06f4e593%3A0xd6e07adca6940a45!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBLaG9hIGjhu41jIFThu7EgbmnDqm4gLSDEkEhRRyBUUEhDTQ!5e0!3m2!1svi!2s!4v1714316143415!5m2!1svi!2s';
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Trường Đại học Khoa học Tự nhiên, 227 Nguyễn Văn Cừ, Quận 5, TP. Hồ Chí Minh')}`;
---
<Layout title={t.title} lang={lang}>
	<PageHeader eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

	<div class="page grid gap-8 py-12 lg:grid-cols-[1fr_1.5fr]">
		<div class="space-y-6">
			<section class="card p-6">
				<h2 class="font-ui text-sm font-semibold text-fg-subtle">{t.email}</h2>
				<a href={`mailto:${site.email}`} class="mt-2 inline-block font-display text-xl font-semibold break-all">{site.email}</a>
			</section>
			<section class="card p-6">
				<h2 class="font-ui text-sm font-semibold text-fg-subtle">{t.address}</h2>
				<address class="mt-2 not-italic space-y-1">
					<p class="font-semibold text-fg">{t.lines[0]}</p>
					{t.lines.slice(1).map((l) => <p class="text-fg-muted">{l}</p>)}
				</address>
				<a href={mapLink} target="_blank" rel="noopener noreferrer" class="link-arrow mt-4">{t.directions} ↗</a>
			</section>
		</div>
		<div class="card overflow-hidden min-h-[360px]">
			<iframe
				src={mapEmbed}
				title={t.map}
				class="block h-full min-h-[360px] w-full border-0"
				loading="lazy"
				allowfullscreen
				referrerpolicy="no-referrer-when-downgrade"
			></iframe>
		</div>
	</div>
</Layout>
