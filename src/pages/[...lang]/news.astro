---
import { list } from '../../content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { type Lang, langPaths, tr, formatDate } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };

const news = (await list('news')).sort((a, b) => +b.date - +a.date);
const t = {
	vi: { title: 'Tin tức', eyebrow: 'Tin tức', h1: 'Tin tức của nhóm', lead: 'Công bố mới, giải thưởng và các sự kiện của PIISA.', more: 'Xem thêm' },
	en: { title: 'News', eyebrow: 'News', h1: 'Lab news', lead: 'New publications, awards, and events at PIISA.', more: 'Read more' },
}[lang];
---
<Layout title={t.title} lang={lang}>
	<PageHeader eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />
	<div class="page py-12">
		<ol class="max-w-3xl border-l border-line">
			{news.map((item) => (
				<li class="relative pb-10 pl-8 last:pb-0">
					<span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-brand-500 ring-4 ring-canvas" aria-hidden="true"></span>
					<time datetime={item.date.toISOString().slice(0, 10)} class="font-ui text-sm font-medium text-fg-subtle">{formatDate(item.date, lang)}</time>
					<p class="mt-2 text-lg text-fg">{tr(item.text, lang)}</p>
					{item.link && <a href={item.link} class="link-arrow mt-3">{t.more} →</a>}
				</li>
			))}
		</ol>
	</div>
</Layout>
