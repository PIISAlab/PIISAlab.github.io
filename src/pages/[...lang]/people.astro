---
import { list } from '../../content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import MemberCard from '../../components/MemberCard.astro';
import { type Lang, langPaths, tr, site, url } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };

const people = await list('people');
const pi = people.find((p) => p.role === 'pi')!;

const t = {
	vi: {
		title: 'Thành viên', eyebrow: 'Thành viên', h1: 'Con người của PIISA', role: 'Trưởng nhóm nghiên cứu (PI)',
		lead: 'Giảng viên, học viên cao học và sinh viên cùng nghiên cứu tại PIISA, cùng các cựu thành viên đã tốt nghiệp.',
		pubs: 'Công bố', email: 'Email',
		sections: { postdoc: 'Nghiên cứu viên Sau Tiến sĩ', phd: 'Nghiên cứu sinh', masters: 'Học viên Cao học', undergrad: 'Sinh viên Đại học', alumni: 'Cựu thành viên' },
	},
	en: {
		title: 'People', eyebrow: 'People', h1: 'The people of PIISA', role: 'Principal Investigator',
		lead: 'Faculty, graduate and undergraduate researchers working at PIISA, and the alumni who have graduated from the lab.',
		pubs: 'Publications', email: 'Email',
		sections: { postdoc: 'Postdoctoral Researchers', phd: 'Ph.D. Students', masters: "Master's Students", undergrad: 'Undergraduate Students', alumni: 'Alumni' },
	},
}[lang];

const sections = [
	{ key: 'postdoc', members: people.filter((p) => p.status === 'current' && p.role === 'postdoc') },
	{ key: 'phd', members: people.filter((p) => p.status === 'current' && p.role === 'phd') },
	{ key: 'masters', members: people.filter((p) => p.status === 'current' && p.role === 'masters') },
	{ key: 'undergrad', members: people.filter((p) => p.status === 'current' && p.role === 'undergrad') },
	{ key: 'alumni', members: people.filter((p) => p.status === 'alumni') },
] as const;
---

<Layout title={t.title} lang={lang}>
	<PageHeader eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

	<div class="page">
		<section class="grid gap-8 border-b border-line py-12 md:grid-cols-[16rem_1fr] md:gap-12">
			<img src={pi.photo} alt={tr(pi.name, lang)} class="w-full max-w-64 aspect-[24/25] object-cover object-top rounded-lg border border-line" />
			<div>
				<p class="eyebrow">{t.role}</p>
				<h2 class="mt-2 text-3xl">{tr(pi.name, lang)}</h2>
				<div class="mt-4 max-w-3xl space-y-4 text-fg-muted">
					{pi.bio?.[lang].map((para) => <p>{para}</p>)}
				</div>
				<div class="mt-6 flex flex-wrap gap-3">
					<a href={`mailto:${site.email}`} class="btn btn-outline">{t.email}: {site.email}</a>
					<a href="https://orcid.org/0000-0003-2934-7924" target="_blank" rel="noopener noreferrer" class="btn btn-outline">ORCID</a>
					<a href={url(lang, '/publications')} class="btn btn-outline">{t.pubs}</a>
				</div>
			</div>
		</section>

		{sections.filter((s) => s.members.length).map((s) => (
			<section class="pt-12" aria-labelledby={`sec-${s.key}`}>
				<h2 id={`sec-${s.key}`} class="section-title flex items-baseline gap-3">
					{t.sections[s.key]}
					<span class="font-ui text-sm font-medium text-fg-subtle tabular-nums">{s.members.length}</span>
				</h2>
				<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
					{s.members.map((m) => <MemberCard member={m} lang={lang} />)}
				</div>
			</section>
		))}
	</div>
</Layout>
