---
import { list } from '../../content';
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import PubItem from '../../components/PubItem.astro';
import { type Lang, langPaths, tr, url, formatDate } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };

const directions = await list('research');
const people = await list('people');
const pubs = await list('publications');
const news = (await list('news')).sort((a, b) => +b.date - +a.date).slice(0, 3);
const papers = pubs.filter((p) => ['journal', 'conference'].includes(p.type));
const recent = [...papers].sort((a, b) => b.year - a.year || a.order - b.order).slice(0, 4);

const stats = [
	{ value: papers.length, label: { vi: 'Bài báo quốc tế', en: 'International papers' }, href: '/publications' },
	{ value: pubs.filter((p) => p.type === 'patent').length, label: { vi: 'Bằng sáng chế US', en: 'US patents' }, href: '/publications' },
	{ value: people.filter((p) => p.status === 'current').length, label: { vi: 'Thành viên hiện tại', en: 'Current members' }, href: '/people' },
	{ value: people.filter((p) => p.status === 'alumni').length, label: { vi: 'Cựu thành viên', en: 'Alumni' }, href: '/people' },
];

const t = {
	vi: {
		title: 'Trang chủ',
		eyebrow: 'Trường ĐH Khoa học Tự nhiên · ĐHQG-HCM',
		h1: ['Hệ thống Thông minh', 'Dựa trên Vật lý'],
		lead: 'PIISA kết hợp các quy luật vật lý cơ bản với trí tuệ nhân tạo hiện đại để giải quyết các bài toán kỹ thuật trong thiết kế vi mạch, hệ thống nhúng & AI biên, và truyền thông vô tuyến 6G.',
		explore: 'Hướng nghiên cứu', pubs: 'Công bố',
		directions: 'Hướng nghiên cứu', directionsLead: 'Ba hướng nghiên cứu bổ trợ nhau, từ phần cứng đến hệ thống và mạng.', more: 'Tìm hiểu thêm',
		news: 'Tin tức', allNews: 'Tất cả tin tức', recent: 'Công bố gần đây', allPubs: 'Toàn bộ công bố',
		joinTitle: 'Tham gia cùng PIISA', joinText: 'Chúng tôi chào đón sinh viên đại học, học viên cao học và nghiên cứu sinh yêu thích vật lý, toán học và kỹ thuật.', join: 'Cơ hội nghiên cứu', contact: 'Liên hệ',
	},
	en: {
		title: 'Home',
		eyebrow: 'University of Science · VNU-HCM',
		h1: ['Physics-Informed', 'Intelligent Systems'],
		lead: 'PIISA combines fundamental physical laws with modern artificial intelligence to solve engineering problems in integrated circuit design, embedded systems & edge AI, and 6G wireless communications.',
		explore: 'Research directions', pubs: 'Publications',
		directions: 'Research directions', directionsLead: 'Three complementary directions, from hardware to systems to networks.', more: 'Learn more',
		news: 'News', allNews: 'All news', recent: 'Recent publications', allPubs: 'All publications',
		joinTitle: 'Join PIISA', joinText: 'We welcome undergraduates, master’s and Ph.D. students with a strong interest in physics, mathematics, and engineering.', join: 'Research opportunities', contact: 'Contact',
	},
}[lang];
const [lead, second, third] = directions;
---

<Layout title={t.title} lang={lang}>
	<!-- Hero -->
	<section class="border-b border-line">
		<div class="page grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[1.1fr_1fr]">
			<div>
				<p class="eyebrow">{t.eyebrow}</p>
				<h1 class="mt-4 text-4xl font-bold leading-[1.1] sm:text-5xl lg:text-6xl">
					{t.h1[0]}<br />
					<span class="bg-gradient-to-r from-slate-900 to-brand-600 bg-clip-text text-transparent dark:from-zinc-900 dark:to-brand-400">{t.h1[1]}</span>
				</h1>
				<p class="mt-6 max-w-xl text-lg text-fg-muted">{t.lead}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href={url(lang, '/research')} class="btn btn-lg btn-primary">{t.explore} <Arrow /></a>
					<a href={url(lang, '/publications')} class="btn btn-lg btn-outline">{t.pubs}</a>
				</div>
			</div>
			<div class="grid grid-cols-2 gap-3" aria-hidden="true">
				<img src={lead.image} alt="" width="1200" height="900" fetchpriority="high" class="col-span-2 w-full aspect-[16/9] object-cover rounded-lg border border-line bg-[#12233F]" />
				<img src={second.image} alt="" width="1200" height="900" loading="lazy" class="w-full aspect-[4/3] object-cover rounded-lg border border-line bg-[#12233F]" />
				<img src={third.image} alt="" width="1200" height="900" loading="lazy" class="w-full aspect-[4/3] object-cover rounded-lg border border-line bg-[#12233F]" />
			</div>
		</div>
	</section>

	<!-- Stats -->
	<section class="border-b border-line bg-subtle">
		<dl class="page grid grid-cols-2 md:grid-cols-4">
			{stats.map((s, i) => (
				<a href={url(lang, s.href)} class:list={['group py-8 px-4 text-fg hover:text-fg', i % 2 === 1 && 'border-l border-line', i >= 2 && 'border-t md:border-t-0 border-line', i === 2 && 'md:border-l']}>
					<dd class="font-display text-3xl font-semibold tabular-nums group-hover:text-fg-brand transition-colors">{s.value}</dd>
					<dt class="mt-1 font-ui text-sm text-fg-muted">{tr(s.label, lang)}</dt>
				</a>
			))}
		</dl>
	</section>

	<!-- Research directions -->
	<section class="page py-16 md:py-20">
		<div class="max-w-2xl">
			<h2 class="section-title">{t.directions}</h2>
			<p class="mt-2 text-fg-muted">{t.directionsLead}</p>
		</div>
		<div class="mt-8 grid gap-6 md:grid-cols-3">
			{directions.map((d) => (
				<a href={`${url(lang, '/research')}#${d.id}`} class="card card-interactive group flex flex-col overflow-hidden text-fg hover:text-fg">
					<img src={d.image} alt={tr(d.imageAlt, lang)} width="1200" height="900" loading="lazy" class="w-full aspect-[4/3] object-cover bg-[#12233F]" />
					<div class="flex flex-1 flex-col p-6">
						<h3 class="text-lg">{tr(d.title, lang)}</h3>
						<p class="mt-2 flex-1 text-fg-muted">{tr(d.summary, lang)}</p>
						<span class="link-arrow mt-4 text-fg-brand">{t.more} <Arrow /></span>
					</div>
				</a>
			))}
		</div>
	</section>

	<!-- News + recent publications -->
	<section class="border-y border-line bg-subtle">
		<div class="page grid gap-12 py-16 md:py-20 lg:grid-cols-[1fr_1.6fr]">
			<div>
				<div class="flex items-baseline justify-between gap-4">
					<h2 class="section-title">{t.news}</h2>
					<a href={url(lang, '/news')} class="link-arrow">{t.allNews} <Arrow /></a>
				</div>
				<ol class="mt-6 space-y-4">
					{news.map((item) => (
						<li class="card p-5">
							<time datetime={item.date.toISOString().slice(0, 10)} class="font-ui text-xs font-medium text-fg-subtle">{formatDate(item.date, lang)}</time>
							<p class="mt-2 text-fg">{tr(item.text, lang)}</p>
						</li>
					))}
				</ol>
			</div>
			<div>
				<div class="flex items-baseline justify-between gap-4">
					<h2 class="section-title">{t.recent}</h2>
					<a href={url(lang, '/publications')} class="link-arrow">{t.allPubs} <Arrow /></a>
				</div>
				<ul class="card mt-6 px-5">
					{recent.map((p) => <PubItem pub={p} lang={lang} />)}
				</ul>
			</div>
		</div>
	</section>

	<!-- Join -->
	<section class="page pt-16 md:pt-20">
		<div class="card flex flex-col gap-6 p-8 md:flex-row md:items-center md:justify-between md:p-10 bg-brand-surface border-transparent">
			<div class="max-w-2xl">
				<h2 class="section-title">{t.joinTitle}</h2>
				<p class="mt-2 text-fg-muted">{t.joinText}</p>
			</div>
			<div class="flex flex-wrap gap-3 shrink-0">
				<a href={url(lang, '/opportunities')} class="btn btn-primary">{t.join} <Arrow /></a>
				<a href={url(lang, '/contact')} class="btn btn-outline bg-card">{t.contact}</a>
			</div>
		</div>
	</section>
</Layout>
