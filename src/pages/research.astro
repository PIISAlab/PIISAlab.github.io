---
import Layout from '../layouts/Layout.astro';
import BentoCard from '../components/BentoCard.astro';
const lang = 'vi';
---
<Layout title="Nghiên cứu" lang={lang}>
	<section class="mb-16">
		<h1 class="text-5xl font-black mb-16 tracking-tighter">
			Nghiên cứu & <span class="text-gradient font-serif">Kỹ thuật</span>
		</h1>

		<div class="bento-grid">
			<BentoCard class="md:col-span-2" showBorderBeam={true}>
				<h2 class="text-3xl mb-8 text-insight font-bold tracking-tight">Trụ cột Nghiên cứu</h2>
				<ul class="space-y-8 text-contrast/80">
					<li class="flex items-start group/item">
						<span class="text-intellect mr-5 text-2xl group-hover/item:translate-x-1 transition-transform">→</span>
						<div>
							<strong class="text-2xl text-starlight tracking-tight">Mạng 6G & Xử lý tín hiệu:</strong>
							<p class="text-lg mt-3 leading-relaxed">Phát triển các thuật toán tiên tiến cho thế hệ mạng không dây tiếp theo, tập trung vào Massive MIMO và Beamforming.</p>
						</div>
					</li>
					<li class="flex items-start group/item">
						<span class="text-intellect mr-5 text-2xl group-hover/item:translate-x-1 transition-transform">→</span>
						<div>
							<strong class="text-2xl text-starlight tracking-tight">Mô phỏng đa vật lý:</strong>
							<p class="text-lg mt-3 leading-relaxed">Mô phỏng các hiện tượng vật lý phức tạp trong ăng-ten, truyền sóng và động học chất lỏng bằng Neural Networks.</p>
						</div>
					</li>
				</ul>
			</BentoCard>
			
			<BentoCard class="bg-gradient-to-br from-intellect/5 to-transparent border-intellect/10">
				<h2 class="text-3xl mb-8 text-intellect font-bold tracking-tight">Đào tạo</h2>
				<ul class="space-y-6 text-contrast/80">
					<li class="p-4 rounded-xl bg-foundation border border-black/5 dark:border-white/5">
						<strong class="text-starlight text-lg block mb-1">Tư duy thiết kế:</strong> 
						<span class="text-base leading-relaxed italic">Lấy con người làm trung tâm trong các giải pháp kỹ thuật.</span>
					</li>
					<li class="p-4 rounded-xl bg-foundation border border-black/5 dark:border-white/5">
						<strong class="text-starlight text-lg block mb-1">Tư duy hệ thống:</strong> 
						<span class="text-base leading-relaxed italic">Phát triển cái nhìn tổng thể về các hệ thống thông minh phức tạp.</span>
					</li>
				</ul>
			</BentoCard>
		</div>
	</section>
</Layout>
