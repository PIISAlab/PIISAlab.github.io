---
import Layout from '../layouts/Layout.astro';
const lang = 'vi';
---
<Layout title="Nghiên cứu" lang={lang}>
	<section class="mb-16">
		<h1 class="text-4xl font-bold mb-12 border-l-4 border-intellect pl-6">
			Nghiên cứu & Kỹ thuật
		</h1>

		<div class="bento-grid">
			<div class="bento-card md:col-span-2">
				<h2 class="text-2xl mb-6 text-insight">Trụ cột Nghiên cứu</h2>
				<ul class="space-y-4 text-contrast/80">
					<li class="flex items-start">
						<span class="text-intellect mr-3">→</span>
						<div>
							<strong class="text-starlight">Mạng 6G & Xử lý tín hiệu:</strong>
							<p class="text-sm mt-1">Phát triển các thuật toán tiên tiến cho thế hệ mạng không dây tiếp theo.</p>
						</div>
					</li>
					<li class="flex items-start">
						<span class="text-intellect mr-3">→</span>
						<div>
							<strong class="text-starlight">Mô phỏng đa vật lý:</strong>
							<p class="text-sm mt-1">Mô phỏng các hiện tượng vật lý phức tạp trong ăng-ten và truyền sóng.</p>
						</div>
					</li>
				</ul>
			</div>
			
			<div class="bento-card">
				<h2 class="text-2xl mb-6 text-intellect">Đào tạo</h2>
				<ul class="space-y-4 text-contrast/80 text-sm">
					<li><strong>Tư duy thiết kế:</strong> Lấy con người làm trung tâm.</li>
					<li><strong>Tư duy hệ thống:</strong> Cái nhìn tổng thể.</li>
				</ul>
			</div>
		</div>
	</section>
</Layout>
