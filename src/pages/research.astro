---
import Layout from '../layouts/Layout.astro';
const lang = 'vi';
---
<Layout title="Research" lang={lang}>
	<section class="mb-16">
		<h1 class="text-4xl font-bold mb-12 border-l-4 border-intellect pl-6">
			{lang === 'vi' ? 'Nghiên cứu & Kỹ thuật' : 'Research & Engineering'}
		</h1>

		<div class="bento-grid">
			<div class="bento-card md:col-span-2">
				<h2 class="text-2xl mb-6 text-insight">{lang === 'vi' ? 'Trụ cột Nghiên cứu' : 'Research Pillars'}</h2>
				<ul class="space-y-4 text-contrast/80">
					<li class="flex items-start">
						<span class="text-intellect mr-3">→</span>
						<div>
							<strong class="text-starlight">Mạng 6G & Xử lý tín hiệu:</strong>
							<p class="text-sm mt-1">{lang === 'vi' ? 'Phát triển các thuật toán tiên tiến cho thế hệ mạng không dây tiếp theo.' : 'Developing advanced algorithms for the next generation of wireless networks.'}</p>
						</div>
					</li>
					<li class="flex items-start">
						<span class="text-intellect mr-3">→</span>
						<div>
							<strong class="text-starlight">Mô phỏng đa vật lý:</strong>
							<p class="text-sm mt-1">{lang === 'vi' ? 'Mô phỏng các hiện tượng vật lý phức tạp trong ăng-ten và truyền sóng.' : 'Simulating complex physical phenomena in antennas and wave propagation.'}</p>
						</div>
					</li>
				</ul>
			</div>
			
			<div class="bento-card">
				<h2 class="text-2xl mb-6 text-intellect">{lang === 'vi' ? 'Đào tạo' : 'Education'}</h2>
				<ul class="space-y-4 text-contrast/80 text-sm">
					<li><strong>Design Thinking:</strong> {lang === 'vi' ? 'Lấy con người làm trung tâm.' : 'Human-centered processes.'}</li>
					<li><strong>Systems Thinking:</strong> {lang === 'vi' ? 'Cái nhìn tổng thể.' : 'Holistic framework.'}</li>
				</ul>
			</div>
		</div>
	</section>
</Layout>
