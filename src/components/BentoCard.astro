---
interface Props {
    class?: string;
    showBorderBeam?: boolean;
}

const { class: className, showBorderBeam = false } = Astro.props;
---

<div class={`bento-card group ${className || ''}`}>
    {showBorderBeam && (
        <div class="absolute inset-0 border-2 border-transparent rounded-[2rem] pointer-events-none overflow-hidden">
            <div class="absolute inset-0 animate-border-beam opacity-0 group-hover:opacity-100 transition-opacity" style="background: conic-gradient(from 0deg at 50% 50%, transparent 0deg, var(--color-intellect) 60deg, var(--color-insight) 120deg, transparent 180deg); width: 200%; height: 200%; top: -50%; left: -50%;"></div>
        </div>
    )}
    <div class="relative z-10">
        <slot />
    </div>
</div>
