---
import { type Lang, nav, site, tr, url } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = {
	vi: { address: ['Phòng thí nghiệm PIISA, Trường Đại học Khoa học Tự nhiên, ĐHQG-HCM', '227 Nguyễn Văn Cừ, Phường 4, Quận 5, TP. Hồ Chí Minh'], pages: 'Trang', contact: 'Liên hệ' },
	en: { address: ['PIISA Lab, University of Science, VNU-HCM', '227 Nguyen Van Cu Street, Ward 4, District 5, Ho Chi Minh City'], pages: 'Pages', contact: 'Contact' },
}[lang];
---
<footer class="mt-24 border-t border-line bg-subtle">
	<div class="page grid gap-10 py-12 md:grid-cols-[2fr_1fr_1.5fr]">
		<div>
			<a href={url(lang, '/')} class="font-display text-lg font-semibold tracking-tight text-fg hover:text-fg">PIISA<span class="text-fg-brand">Lab</span></a>
			<p class="mt-3 max-w-md text-sm text-fg-muted">{tr(site.fullName, lang)}</p>
			<p class="mt-1 max-w-md text-sm text-fg-subtle">{tr(site.affiliation, lang)}</p>
		</div>
		<div>
			<h2 class="eyebrow !text-fg-subtle">{t.pages}</h2>
			<ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm md:grid-cols-1">
				{nav.filter((n) => n.path !== '/').map((n) => <li><a href={url(lang, n.path)} class="text-fg-muted hover:text-fg">{n.label[lang]}</a></li>)}
			</ul>
		</div>
		<div>
			<h2 class="eyebrow !text-fg-subtle">{t.contact}</h2>
			<address class="mt-3 not-italic text-sm text-fg-muted space-y-1">
				{t.address.map((line) => <p>{line}</p>)}
				<p class="pt-1"><a href={`mailto:${site.email}`}>{site.email}</a></p>
			</address>
		</div>
	</div>
	<div class="border-t border-line">
		<p class="page py-5 font-ui text-xs text-fg-subtle">© {new Date().getFullYear()} PIISA Lab · <a href="https://hcmus.edu.vn/" target="_blank" rel="noopener noreferrer" class="text-fg-subtle hover:text-fg">{lang === 'vi' ? 'Trường ĐH Khoa học Tự nhiên, ĐHQG-HCM' : 'University of Science, VNU-HCM'}</a></p>
	</div>
</footer>
