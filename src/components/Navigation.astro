---
import { type Lang, nav, url, switchUrl } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const current = Astro.url.pathname.replace(/\/$/, '').replace(/^\/en(?=\/|$)/, '') || '/';
const items = nav.map((item) => ({ href: url(lang, item.path), label: item.label[lang], active: item.path === current }));
const targetUrl = switchUrl(lang, Astro.url.pathname);
const t = {
	vi: { menu: 'Mở menu', theme: 'Đổi giao diện sáng/tối', switchTo: 'English', switchShort: 'EN' },
	en: { menu: 'Open menu', theme: 'Toggle light/dark theme', switchTo: 'Tiếng Việt', switchShort: 'VI' },
}[lang];
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas/80 backdrop-blur-md">
	<nav class="page flex h-16 items-center justify-between gap-6" aria-label={lang === 'vi' ? 'Điều hướng chính' : 'Main'}>
		<a href={url(lang, '/')} class="flex items-baseline gap-1.5 font-display text-lg font-semibold tracking-tight text-fg hover:text-fg">
			PIISA<span class="text-fg-brand">Lab</span>
		</a>

		<ul class="hidden lg:flex items-center gap-1">
			{items.map((item) => (
				<li>
					<a
						href={item.href}
						aria-current={item.active ? 'page' : undefined}
						class:list={[
							'font-ui text-sm font-medium rounded-md px-3 py-2 transition-colors',
							item.active ? 'bg-brand-surface text-fg-brand' : 'text-fg-muted hover:text-fg hover:bg-subtle',
						]}
					>{item.label}</a>
				</li>
			))}
		</ul>

		<div class="flex items-center gap-1">
			<a href={targetUrl} hreflang={lang === 'vi' ? 'en' : 'vi'} title={t.switchTo} class="font-ui text-xs font-semibold rounded-md px-2.5 py-2 text-fg-muted hover:text-fg hover:bg-subtle">
				{t.switchShort}
			</a>
			<button type="button" data-theme-toggle aria-label={t.theme} title={t.theme} class="rounded-md p-2 text-fg-muted hover:text-fg hover:bg-subtle">
				<!-- moon (shown in light mode) / sun (shown in dark mode) -->
				<svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
				<svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m-7.07-2.93 1.41-1.41m11.32-11.32 1.41-1.41M2 12h2m16 0h2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41"/></svg>
			</button>
			<button type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label={t.menu} class="lg:hidden rounded-md p-2 text-fg-muted hover:text-fg hover:bg-subtle">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
			</button>
		</div>
	</nav>

	<div id="mobile-menu" hidden class="lg:hidden border-t border-line bg-canvas">
		<ul class="page py-3 flex flex-col">
			{items.map((item) => (
				<li>
					<a
						href={item.href}
						aria-current={item.active ? 'page' : undefined}
						class:list={['block font-ui font-medium rounded-md px-3 py-2.5', item.active ? 'bg-brand-surface text-fg-brand' : 'text-fg-muted hover:bg-subtle hover:text-fg']}
					>{item.label}</a>
				</li>
			))}
		</ul>
	</div>
</header>

<script>
	document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
		const dark = document.documentElement.classList.toggle('dark');
		try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
	});
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.getElementById('mobile-menu');
	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') !== 'true';
		toggle.setAttribute('aria-expanded', String(open));
		if (menu) menu.hidden = !open;
	});
</script>
