---
import ThemeToggle from './ThemeToggle';
import MobileMenu from './MobileMenu';

import { type Lang, nav, url, switchUrl } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const menuItems = nav.map((item) => ({ href: url(lang, item.path), label: item.label[lang], path: item.path }));
const targetUrl = switchUrl(lang, Astro.url.pathname);

---

<nav class="sticky top-0 z-50 bg-foundation/80 backdrop-blur-md border-b border-neutral-200 dark:border-neutral-800 transition-colors">
	<div class="container mx-auto px-4">
		<!-- Venizia spec §B.8 TopBar: 64px height (h-16) -->
		<div class="flex justify-between items-center h-16">
			<!-- Logo: Montserrat 900 (font-black) per Venizia §4.1 display family -->
			<a href={url(lang, '/')} class="text-2xl font-montserrat font-black text-starlight tracking-tight transition-colors">
				PIISA<span class="text-intellect">Lab</span>
			</a>

			<!-- Nav links: Inter 500 (font-medium) per Venizia §4.3 chrome typography -->
			<ul class="hidden md:flex space-x-8">
				{menuItems.map(item => {
					return (
						<li>
							<a href={item.href} class="text-sm font-inter font-medium hover:text-intellect dark:hover:text-insight transition-colors">
								{item.label}
							</a>
						</li>
					);
				})}
			</ul>

			<div class="flex items-center space-x-4">
				<ThemeToggle client:load />
				<a
					href={targetUrl}
					class="text-xs font-inter font-semibold px-3 py-2 rounded-md bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 transition-colors"
				>
					{lang === 'vi' ? '🇺🇸 EN' : '🇻🇳 VN'}
				</a>
				<MobileMenu client:load menuItems={menuItems} />
			</div>
		</div>
	</div>
</nav>
