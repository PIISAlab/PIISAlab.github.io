---
import type { CollectionEntry } from 'astro:content';
import { type Lang, tr } from '../i18n';

interface Props {
	member: CollectionEntry<'people'>['data'];
	lang: Lang;
}

const { member, lang } = Astro.props;
const name = tr(member.name, lang);
const initials = name.split(/\s+/).map((w) => w[0]).join('').slice(-3).toUpperCase();
const alumni = member.status === 'alumni';

const L = {
	vi: {
		'senior-thesis': 'Khóa luận TN', 'masters-thesis': 'Luận văn ThS', 'phd-dissertation': 'Luận án TS',
		graduated: 'Đã tốt nghiệp', topic: 'Đề tài', tentative: 'Đề tài (dự kiến)', abstract: 'Tóm tắt', firstJob: 'Công việc đầu tiên sau khi tốt nghiệp',
	},
	en: {
		'senior-thesis': 'Senior Thesis', 'masters-thesis': "Master's Report", 'phd-dissertation': 'Ph.D. Dissertation',
		graduated: 'Graduated', topic: 'Project', tentative: 'Project (tentative)', abstract: 'Abstract', firstJob: 'First Job After Graduation',
	},
}[lang];

const badge = alumni ? L.graduated : member.thesis ? L[member.thesis.kind] : undefined;
---

<article class="card flex flex-col overflow-hidden">
	{member.photo ? (
		<img src={member.photo} alt={name} loading="lazy" decoding="async" class:list={['w-full aspect-[24/25] object-cover object-top bg-subtle', alumni && 'grayscale-[35%]']} />
	) : (
		<div class="w-full aspect-[24/25] bg-subtle flex items-center justify-center" aria-hidden="true">
			<span class="font-display text-4xl font-semibold text-fg-subtle">{initials}</span>
		</div>
	)}
	<div class="flex flex-1 flex-col p-5">
		<h3 class="text-lg">{name}</h3>
		<div class="mt-2 flex flex-wrap gap-1.5">
			{member.cohort && <span class="tag tag-brand">{member.cohort}</span>}
			{badge && <span class="tag">{badge}</span>}
		</div>
		{member.thesis && (
			<div class="mt-4 border-t border-line pt-4">
				<p class="font-ui text-xs font-medium text-fg-subtle">{member.thesis.tentative ? L.tentative : L.topic}</p>
				{member.thesis.abstract ? (
					<details class="group mt-1">
						<summary class="flex cursor-pointer list-none items-start gap-1.5 text-sm font-medium text-fg [&::-webkit-details-marker]:hidden">
							<svg class="mt-1 shrink-0 text-fg-subtle transition-transform group-open:rotate-90" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
							<span>{tr(member.thesis.title, lang)}</span>
						</summary>
						<div class="mt-3 pl-[18px]">
							<p class="font-ui text-xs font-medium text-fg-subtle">{L.abstract}</p>
							<p class="mt-1 text-sm text-fg-muted">{tr(member.thesis.abstract, lang)}</p>
						</div>
					</details>
				) : (
					<p class="mt-1 text-sm font-medium text-fg">{tr(member.thesis.title, lang)}</p>
				)}
			</div>
		)}
		{member.firstJob && (
			<div class="mt-4">
				<p class="font-ui text-xs font-medium text-fg-subtle">{L.firstJob}</p>
				<p class="mt-1 text-sm">
					{member.firstJob.url
						? <a href={member.firstJob.url} target="_blank" rel="noopener noreferrer">{tr(member.firstJob.name, lang)}</a>
						: tr(member.firstJob.name, lang)}
				</p>
			</div>
		)}
	</div>
</article>
